{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build App",
      "type": "shell",
      "command": "cmd /C \"npm run build\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Install Vitest Browser",
      "type": "shell",
      "command": "cmd /C \"npm install -D @vitest/browser-playwright\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test App",
      "type": "shell",
      "command": "cmd /C \"npm run test -- --watch=false --browser=chromium\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
